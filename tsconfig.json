{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": "extension",
    "rootDir": "src",
    "skipLibCheck": true,
    "types": ["chrome"],
    "declaration": false
  },
  "include": ["src/**/*.ts"]
}
