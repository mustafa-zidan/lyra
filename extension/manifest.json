{
  "manifest_version": 3,
  "name": "Lyra: Text to Speech",
  "version": "0.1.0",
  "description": "Read any selected text or full web page aloud using the Lyra TTS server.",

  "permissions": ["contextMenus", "storage", "activeTab", "scripting"],

  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],

  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"],
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["fonts/*.woff2"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Lyra TTS"
  },

  "commands": {
    "read-selection": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Read the selected text aloud"
    },
    "read-page": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Read the page aloud"
    },
    "toggle-pause": {
      "suggested_key": { "default": "Alt+Shift+Space" },
      "description": "Pause or resume reading"
    },
    "stop": {
      "suggested_key": { "default": "Alt+Shift+X" },
      "description": "Stop reading"
    },
    "reader-view": {
      "description": "Open or close the reader view"
    },
    "back": {
      "description": "Back one passage"
    },
    "forward": {
      "description": "Forward one passage"
    }
  },

  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },

  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "lyra-tts@extension",
      "strict_min_version": "112.0"
    }
  }
}
