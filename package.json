{
  "name": "lyra-extension",
  "version": "0.1.0",
  "description": "Lyra TTS browser extension",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "lint:js": "eslint src/",
    "lint:js:fix": "eslint src/ --fix",
    "format:js": "prettier --write \"src/**/*.{ts,json,css,html}\"",
    "format:js:check": "prettier --check \"src/**/*.{ts,json,css,html}\"",
    "build:ts": "tsc",
    "typecheck": "tsc --noEmit",
    "build:ext": "web-ext build --source-dir extension/ --artifacts-dir dist/ --overwrite-dest",
    "test:ext": "tsc && playwright test",
    "generate-icons": "node scripts/generate-icons.js",
    "vendor:readability": "cp node_modules/@mozilla/readability/Readability.js extension/vendor/Readability.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mozilla/readability": "^0.6.0",
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.3.6",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "web-ext": "^10.8.0"
  }
}
